# quick harness validation: small files, short run
# report bandwidth
# NOTE: file layout is normally handled by the auto-generated 000-wekatester-layout job; the create section below remains for standalone fio use.
[global]
filesize=256M
time_based=1
startdelay=2
exitall_on_error=1
create_serialize=0
# flat names (no subdirs): unlink below removes files, leaving nothing behind
filename_format=wekatester-smoke.$jobnum
directory=/mnt/weka
group_reporting=1
runtime=10
ioengine=libaio
disk_util=0
direct=1
numjobs=4

[smoke-createfiles]
blocksize=1Mi
description='pre-create files'
create_only=1

[smoke-readbw]
stonewall
description='sequential read bandwidth smoke test'
blocksize=1Mi
rw=read
iodepth=4
# smoke test cleans up after itself; only the last job may unlink,
# or the measured job would lose the files the create job laid out
unlink=1
